# WAHA Configuration
WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=your-waha-api-key
WAHA_SESSION=default
# Comma-separated: nomor WA dan LID bot (lihat log debug untuk tahu format yang dipakai)
BOT_MENTIONS=6281818181

# Owner's LID for tagging in groups (Fikri)
OWNER_MENTION_ID=62818181881

# LLM Configuration (ollama-model server)
LLM_BASE_URL=http://localhost:3002/v1
LLM_API_KEY=
LLM_MODELS=llama3
EMBEDDING_MODEL=nomic-embed-text
VECTOR_SIZE=768

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key

# Server Configuration
PORT=3001
